#!/bin/bash

#configure gpus
sudo bash -c '

  echo "setting gpu performance options..."

  for card in /sys/class/drm/card*/device; do
    [ -d "$card" ] || continue

    #amdgpu
    if [ -e "$card/power_dpm_force_performance_level" ]; then
      (
        if [ -e "$card/pp_power_profile_mode" ]; then
          echo "manual" >"$card/power_dpm_force_performance_level"
          #set vr profile
          amdprofile=$(grep --color=never "VR.*:" "$card/pp_power_profile_mode" | awk "{print \$1}" 2>/dev/null)
          if [ ! -z "$amdprofile" ] && [ -e "$card/pp_power_profile_mode" ]; then
            echo "$amdprofile" >"$card/pp_power_profile_mode"
          else
            echo "high" >"$card/power_dpm_force_performance_level"
          fi
        else
          echo "high" >"$card/power_dpm_force_performance_level"
        fi
        if [ -e "$card/pp_dpm_mclk" ]; then
          #force memory clock to full
          echo "3" >"$card/pp_dpm_mclk"
        fi
      ) >> /tmp/gpu-amdgpu.log 2>&1
    fi
  done

  for card in /sys/class/drm/card*; do
    [ -d "$card" ] || continue

    #intel
    if [ -e "$card/gt_max_freq_mhz" ]; then
      (
        if [ -e "$card/gt_boost_freq_mhz" ]; then
          maxfreq=$(cat "$card/gt_boost_freq_mhz" | head -n1)
        else
          maxfreq=$(cat "$card/gt_max_freq_mhz" | head -n1)
        fi
        if [ ! -z "$maxfreq" ]; then
          #force max frequency
          echo "$maxfreq" >"$card/gt_min_freq_mhz"
        fi
      ) >> /tmp/gpu-intel.log 2>&1
    fi
  done

  #nvidia
  if lsmod|grep nvidia_modeset >/dev/null 2>&1;then
    (
      for i in $(seq 0 2); do
        nvidia-settings -a "[gpu:$i]/GpuPowerMizerMode=1"
      done
      nvidia-settings -a AllowVRR=0
      nvidia-settings -a OpenGLImageSettings=3
      nvidia-settings -a SyncToVBlank=0
      nvidia-settings -a AllowFlipping=1
    ) > /tmp/gpu-nvidia.log 2>&1
  fi

' > /tmp/gpu.log 2>&1 &

